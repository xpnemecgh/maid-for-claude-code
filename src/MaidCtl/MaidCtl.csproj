<Project Sdk="Microsoft.NET.Sdk">

  <!-- maidctl: Maid's API from the command line. Maid.csproj builds it along and puts it into cli\ next to Maid.exe,
       which Maid puts first on the PATH of its sessions. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>maidctl</AssemblyName>
    <RootNamespace>MaidCtl</RootNamespace>
    <!-- Goes with Maid's: raise both together (src\Maid\Maid.csproj). -->
    <Version>1.6</Version>
    <Product>Maid</Product>
    <Description>Controls Maid (the dashboard of Claude Code sessions) through its API pipe</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
