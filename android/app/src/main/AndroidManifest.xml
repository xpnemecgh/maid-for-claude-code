<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "Waiting for you" when a session finishes while the app is in the background -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The connection stays open in the background (a notification shows it and can end it) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Unlocking the app with a fingerprint, the face or the screen lock -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Dictation: recorded in the app, written out by Maid on the PC (asked for at the first dictation) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- The voice assistant app (maid.voiceApp.package) hands "on computer" requests to JarvisRelay, which checks its certificate -->
    <queries>
        <package android:name="${voiceAppPackage}" />
    </queries>

    <!-- back comes through OnBackInvokedCallback from Android 13 on -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Maid"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|fontScale|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".MaidService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the connection to the user's own PC (Maid, a dashboard of terminal sessions) open, so the user can follow and use their sessions from the phone" />
        </service>

        <!-- Exported for one app only: JarvisRelay lets in nobody but the voice assistant app the build names, with its certificate -->
        <service
            android:name=".JarvisRelay"
            android:exported="true" />
    </application>
</manifest>
