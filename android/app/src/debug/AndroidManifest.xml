<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: adb tries Maid's API from the phone's side (PhoneApi), as Jarvis would through
             JarvisRelay. The adb command is in DebugApiReceiver.kt; answers go to logcat, tag MaidApi. -->
        <receiver
            android:name=".DebugApiReceiver"
            android:exported="true" />
    </application>
</manifest>
